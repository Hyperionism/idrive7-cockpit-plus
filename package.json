{
  "name": "idrive7-cockpit-plus",
  "version": "0.9.5",
  "private": true,
  "description": "Cockpit+ overlay suite for BMW iDrive 7 (MGU): Cluster+ calibrated right wing, per-line left vitals, 5AU top lane bar, iOS turn card, arrival ETA pill, and bold HUD nav",
  "license": "GPL-3.0-only",
  "scripts": {
    "test": "node test/run_tests.js && node test/fullview_companion_test.js",
    "bench": "node bench/server.js",
    "build:stub": "python3 vendor/cauliflowermossgrape-idrive7-apps/kit/tools/build.py --app-root . --stub-sdk id7_cockpit_plus",
    "build:release": "python3 vendor/cauliflowermossgrape-idrive7-apps/kit/tools/build.py --app-root . --language zh-CN --omit-sdk id7_cockpit_plus"
  }
}
